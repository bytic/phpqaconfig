{
    "name": "bytic/phpqaconfig",
    "description": "Meta package for configuration files for PHP QA tools",
    "type": "library",
    "keywords": [
        "php",
        "qa",
        "quality",
        "code quality",
        "stylecheck",
        "unittest"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Solomon Gabriel",
            "email": "hello@gabrielsolomon.ro",
            "homepage": "http://gabrielsolomon.ro",
            "role": "Developer"
        }
    ],
    "autoload": {
        "files": [
            "rules/PhpCsFixer/helpers.php"
        ]
    },
    "require": {
        "php": "^7.4 || ^8",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcsstandards/phpcsextra": "^1.5",
        "phpcsstandards/phpcsutils": "^1.2",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "suggest": {
    },
    "bin": [
        "bin/qaconfig"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
